#: data/io.github.un1tz3r0.VcvPluginInstaller.desktop.in:4
#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:7
#: vcvplugin/gui.py:17
msgid "VCV Rack Plugin Installer"
msgstr "Instalador de complementos de VCV Rack"

#: data/io.github.un1tz3r0.VcvPluginInstaller.desktop.in:5
#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:8
msgid "Install and upgrade VCV Rack 2 plugin packages"
msgstr "Instale y actualice paquetes de complementos de VCV Rack 2"

#: data/io.github.un1tz3r0.VcvPluginInstaller.desktop.in:11
msgid "VCV;Rack;plugin;modular;"
msgstr "VCV;Rack;plugin;complemento;modular;sintetizador;"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:14
msgid ""
"VCV Rack 2 unpacks .vcvplugin packages from its plugins folder the next time "
"it starts, without saying what changed. This installer checks each package "
"first, shows what installing it will do, and unpacks it right away."
msgstr ""
"VCV Rack 2 desempaqueta los paquetes .vcvplugin de su carpeta de "
"complementos la próxima vez que se inicia, sin indicar qué cambió. Este "
"instalador revisa primero cada paquete, muestra qué hará su instalación y lo "
"desempaqueta de inmediato."

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:20
msgid ""
"Rejects packages built for another operating system or CPU, or without a "
"valid plugin.json"
msgstr ""
"Rechaza paquetes compilados para otro sistema operativo o procesador, o sin "
"un plugin.json válido"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:21
msgid "Shows whether each package is a new install, an upgrade or a downgrade"
msgstr ""
"Muestra si cada paquete es una instalación nueva, una actualización o una "
"versión anterior"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:22
msgid "Warns when the same version is already installed with different files"
msgstr "Avisa cuando la misma versión ya está instalada con archivos distintos"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:23
msgid "Replaces older packages that are still waiting for Rack to unpack them"
msgstr ""
"Reemplaza los paquetes antiguos que aún esperan a que Rack los desempaquete"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:25
msgid ""
"Plugins are unpacked into a staging folder and then swapped into place, so "
"an interrupted install does not leave a half-written plugin behind. The "
"vcvplugin-install command does the same from a terminal."
msgstr ""
"Los complementos se desempaquetan en una carpeta temporal y luego se colocan "
"en su sitio, de modo que una instalación interrumpida no deja un complemento "
"a medio escribir. La orden vcvplugin-install hace lo mismo desde una "
"terminal."

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:62
#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:66
msgid "Review what installing each package will do"
msgstr "Revise qué hará la instalación de cada paquete"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:70
#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:74
msgid "Confirm downgrades and same-version rebuilds"
msgstr "Confirme versiones anteriores y recompilaciones de la misma versión"

#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:78
#: data/io.github.un1tz3r0.VcvPluginInstaller.metainfo.xml:82
msgid "Installed plugins, ready to start VCV Rack"
msgstr "Complementos instalados, listos para iniciar VCV Rack"

#: data/io.github.un1tz3r0.VcvPluginInstaller.Terminal.desktop.in:4
msgid "Install VCV Rack Plugin (Terminal)"
msgstr "Instalar complemento de VCV Rack (terminal)"

#: data/io.github.un1tz3r0.VcvPluginInstaller.Terminal.desktop.in:5
msgid "Install VCV Rack 2 plugin packages in a terminal"
msgstr "Instale paquetes de complementos de VCV Rack 2 en una terminal"

