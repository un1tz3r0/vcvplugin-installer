[Desktop Entry]
Type=Application
Name=VCV Rack Plugin Installer
Comment=Install and upgrade VCV Rack 2 plugin packages
Exec=@bindir@/vcvplugin-gui %F
Icon=io.github.un1tz3r0.VcvPluginInstaller
